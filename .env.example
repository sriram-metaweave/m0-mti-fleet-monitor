# mti-fleet-monitor — environment.
#
# QUOTING: Bun's dotenv treats an unquoted `#` as a comment, so single-quote any
# password carrying `#`, a space or a quote.

# ── Database ──────────────────────────────────────────────────────────────
# Inside the LifeOS workspace container this app authenticates as its own
# container identity (IAM) and none of the vars below are needed — see
# src/server/db.ts mode 1.
#
# Anywhere else (e.g. Vercel), use password mode instead — mode 2 in db.ts,
# the same shape as lifeos-apps/anomaly-detect:
CLOUD_SQL_INSTANCE_CONNECTION_NAME=lifeosai-481608:asia-south1:lifeosai-db
DB_NAME=nyk_mti
DB_USER=metaweave_user
# DB_PASSWORD is set directly as a platform secret, never committed.
# GOOGLE_SERVICE_ACCOUNT_BASE64 likewise — base64 of the service-account JSON
# key the Cloud SQL Connector uses to establish mTLS.

# Pin the business (living_office.domain.slug). Unset = every vessel entity.
# DOMAIN_SLUG=eums

# There is no sign-in. Whoever reaches the URL reads this business — put the
# app behind a host that decides who can reach it.

# ── Host ─────────────────────────────────────────────────────────────────
# PORT is supplied by the LifeOS host; unset on Vercel (harmless — see config.ts).
# FRAME_ANCESTORS=https://preview.example.com   extra origins allowed to frame this
